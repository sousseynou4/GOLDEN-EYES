# ═══════════════════════════════════════════════════════════════
# GOLDEN EYES — Variables d'environnement
# ───────────────────────────────────────────────────────────────
# Duplique ce fichier en `.env.local` puis remplis les valeurs.
# Ne jamais commit `.env.local` !
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# SUPABASE (Étape 2)
# ─────────────────────────────────────────────────────────────
# Récupère ces clés depuis : https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
# ⚠️ Server-only — JAMAIS exposée côté client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# ─────────────────────────────────────────────────────────────
# CLOUDINARY (Étape 4 - médias)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────
# EMAILS — Resend (Étape 6)
# ─────────────────────────────────────────────────────────────
# Crée un compte gratuit sur https://resend.com puis :
#   API Keys → Create API Key → copie la clé ici
RESEND_API_KEY=
# Expéditeur. Tant qu'aucun domaine n'est vérifié, garde la valeur de test :
EMAIL_FROM=Golden Eyes <onboarding@resend.dev>
# Adresse où TU reçois les notifications de nouvelles demandes :
ADMIN_EMAIL=admin@golden-eyes.fr

# ─────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
